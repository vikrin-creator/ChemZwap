Options -Indexes

RewriteEngine On
RewriteBase /api/

# Handle CORS preflight OPTIONS requests - return 200 immediately
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]

# Don't rewrite real files or directories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route all requests through index.php with the route as a query param
RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]
